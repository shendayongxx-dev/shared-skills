{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "A-D-2.0"
    },
    "request_id": {
      "type": "string"
    },
    "version_id": {
      "type": "string"
    },
    "agent_name": {
      "const": "consumer_agent"
    },
    "score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "pass": {
      "type": "boolean"
    },
    "dimension_scores": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "product_recognition": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "benefit_clarity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "offer_visibility": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "population_scene_fit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "purchase_drive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      },
      "required": [
        "product_recognition",
        "benefit_clarity",
        "offer_visibility",
        "population_scene_fit",
        "purchase_drive"
      ],
      "additionalProperties": false
    },
    "problem_list": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 3
    },
    "modify_suggestion": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 3
    },
    "protected_content": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "product_identity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "product_quantity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "brand_and_logo": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "price_and_unit": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "promotion_and_period": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selling_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cta": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "legal_text": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "product_identity",
        "product_quantity",
        "brand_and_logo",
        "price_and_unit",
        "promotion_and_period",
        "selling_points",
        "cta",
        "legal_text"
      ],
      "additionalProperties": false
    },
    "locked_dimensions": {
      "type": "array",
      "items": {
        "enum": [
          "product_recognition",
          "benefit_clarity",
          "offer_visibility",
          "population_scene_fit",
          "purchase_drive"
        ]
      },
      "uniqueItems": true
    },
    "regressed_dimensions": {
      "type": "array",
      "items": {
        "enum": [
          "product_recognition",
          "benefit_clarity",
          "offer_visibility",
          "population_scene_fit",
          "purchase_drive"
        ]
      },
      "uniqueItems": true
    },
    "hard_fail": {
      "type": "boolean"
    },
    "next_route": {
      "enum": [
        "poster_generation_skill",
        "aesthetic_agent",
        "complete_input"
      ]
    },
    "meta": {
      "type": "object",
      "properties": {
        "judge_dimensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "input_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown_dimensions": {
          "type": "array",
          "items": {
            "enum": [
              "product_recognition",
              "benefit_clarity",
              "offer_visibility",
              "population_scene_fit",
              "purchase_drive"
            ]
          },
          "uniqueItems": true
        },
        "context_hash": {
          "type": "string"
        },
        "dimension_evidence": {
          "type": "object",
          "properties": {
            "product_recognition": {
              "type": "string"
            },
            "benefit_clarity": {
              "type": "string"
            },
            "offer_visibility": {
              "type": "string"
            },
            "population_scene_fit": {
              "type": "string"
            },
            "purchase_drive": {
              "type": "string"
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "judge_dimensions",
        "confidence",
        "input_errors",
        "unknown_dimensions",
        "context_hash",
        "dimension_evidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "version_id",
    "agent_name",
    "score",
    "pass",
    "dimension_scores",
    "problem_list",
    "modify_suggestion",
    "protected_content",
    "locked_dimensions",
    "regressed_dimensions",
    "hard_fail",
    "next_route",
    "meta"
  ],
  "additionalProperties": false
}
