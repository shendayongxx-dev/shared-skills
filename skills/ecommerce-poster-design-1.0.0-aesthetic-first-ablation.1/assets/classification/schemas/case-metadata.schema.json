{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "tags",
    "rule_ids",
    "is_seed",
    "review",
    "asset",
    "source",
    "rights",
    "style_analysis",
    "content_review"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^C-[0-9]{3}$"
    },
    "tags": {
      "type": "object",
      "required": [
        "audience_id",
        "motivation_id",
        "scenario_id"
      ]
    },
    "rule_ids": {
      "type": "array"
    },
    "is_seed": {
      "type": "boolean"
    },
    "review": {
      "type": "object",
      "required": [
        "review_status",
        "reviewer",
        "reviewed_at",
        "note"
      ],
      "properties": {
        "review_status": {
          "enum": [
            "draft",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "storage_type",
        "local_path",
        "internal_asset_uri",
        "external_image_url",
        "mime_type",
        "format",
        "width",
        "height",
        "bytes",
        "checksum",
        "public_repository_allowed"
      ],
      "properties": {
        "storage_type": {
          "type": "string"
        },
        "local_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "internal_asset_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "external_image_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "checksum": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "algorithm",
                "value"
              ],
              "properties": {
                "algorithm": {
                  "const": "sha256"
                },
                "value": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "public_repository_allowed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "platform",
        "url",
        "usage_status"
      ]
    },
    "rights": {
      "type": "object",
      "required": [
        "rights_status",
        "rights_proof_ref",
        "redistribution_status",
        "scope"
      ]
    },
    "style_analysis": {
      "type": "object"
    },
    "content_review": {
      "type": "object",
      "required": [
        "content_review_status",
        "reviewer_role",
        "reviewed_at",
        "note",
        "evidence_ref"
      ],
      "properties": {
        "content_review_status": {
          "enum": [
            "unreviewed",
            "reviewed"
          ]
        },
        "reviewer_role": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "evidence_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "is_seed": {
            "const": true
          }
        },
        "required": [
          "is_seed"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "review_status": {
                "const": "approved"
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "asset": {
            "properties": {
              "mime_type": {
                "type": "string",
                "minLength": 1
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "checksum": {
                "type": "object"
              }
            }
          },
          "rights": {
            "properties": {
              "rights_status": {
                "enum": [
                  "owned",
                  "licensed",
                  "permission_granted",
                  "public_domain",
                  "internal_authorized"
                ]
              },
              "rights_proof_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
