{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "input.schema.json",
  "title": "Aesthetic Agent workflow input",
  "type": "object",
  "properties": {
    "schema_version": {"const": "A-D-AESTHETIC-3.0"},
    "candidate": {"$ref": "consumer-input.schema.json"},
