{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "rules_version",
    "taxonomy_version",
    "fallback_order",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "rules_version": {
      "const": "2.0.1"
    },
    "taxonomy_version": {
      "const": "1.0"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "priority",
          "match",
          "status",
          "style",
          "recommended_case_ids"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^R-(DEFAULT|[0-9]{3})$"
          },
          "priority": {
            "type": "integer"
          },
          "match": {
            "type": "object"
          },
          "status": {
            "enum": [
              "active",
              "inactive",
              "draft",
              "deprecated"
            ]
          },
          "extends_rule_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "style": {
            "type": "object",
            "properties": {
              "headline_character": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "body_character": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "composition": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "product_ratio": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "info_density": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "promotion_intensity": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "cta_guidance": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "prohibited_styles": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "palette_sets": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "object",
                  "required": [
                    "palette_id",
                    "colors"
                  ],
                  "properties": {
                    "palette_id": {
                      "type": "string"
                    },
                    "colors": {
                      "type": "array",
                      "minItems": 4,
                      "items": {
                        "type": "object",
                        "required": [
                          "role",
                          "hex"
                        ],
                        "properties": {
                          "role": {
                            "enum": [
                              "background",
                              "support",
                              "accent",
                              "text",
                              "material"
                            ]
                          },
                          "hex": {
                            "type": "string",
                            "pattern": "^#[0-9A-Fa-f]{6}$"
                          },
                          "name": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "hierarchy_preference": {
                "type": [
                  "array",
                  "string",
                  "null"
                ]
              }
            }
          },
          "recommended_case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^C-[0-9]{3}$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
