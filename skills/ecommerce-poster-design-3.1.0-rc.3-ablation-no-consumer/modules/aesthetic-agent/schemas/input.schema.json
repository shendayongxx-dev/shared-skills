{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "input.schema.json",
  "title": "No-consumer aesthetic workflow input",
  "type": "object",
  "properties": {
    "schema_version": {"const": "A-D-AESTHETIC-3.1-ABLATION-NO-CONSUMER"},
    "ablation": {
      "type": "object",
      "properties": {
        "id": {"const": "no-consumer"},
        "base_version": {"const": "3.1.0-rc.3"},
        "consumer_artifacts_used": {"const": false}
      },
      "required": ["id", "base_version", "consumer_artifacts_used"],
      "additionalProperties": false
    },
    "candidate": {"type": "object"}
  },
  "required": ["schema_version", "ablation", "candidate"],
  "additionalProperties": false
}
