{
  "skill_version": "3.1.0-rc.3-ablation-no-consumer",
  "release_channel": "ablation-experiment",
  "production_ready": false,
  "ablation": {
    "id": "no-consumer",
    "base_version": "3.1.0-rc.3",
    "single_removed_component": "consumer_agent_and_all_consumer_artifacts",
    "consumer_artifacts_allowed": false
  },
  "generation_backend": {
    "skill": "imagegen",
    "tool": "image_gen",
    "mode": "builtin",
    "required": true,
    "cli_fallback_requires_user_confirmation": true,
    "svg_logo_pipeline": {
      "enabled": true,
      "authoritative_source_preserved": true,
      "preflight_schema": "logo-asset-preflight/1.0",
      "application_schema": "logo-application/1.0",
      "default_raster_long_edge": 2048,
      "generation_strategy": "reserve_then_deterministic_composite"
    }
  },
  "aesthetic_agent_module": {
    "name": "ecommerce-aesthetic-agent-3-0-0-rc-4-ablation-adapter",
    "rubric_version": "3.0.0-rc.4",
    "interface_version": "A-D-AESTHETIC-3.1-ABLATION-NO-CONSUMER",
    "path": "modules/aesthetic-agent",
    "consumer_dependency_removed": true
  },
  "c_library": {
    "status": "connected",
    "official_asset_version": "2.0.1-a.1",
    "source_schema_version": "2.0.0"
  },
  "workflow_version": "3.1-ablation-no-consumer",
  "generation_edit_contract_version": "aesthetic-edit-lock-no-consumer/1.0",
  "final_quality_edit_contract_version": "final-quality-edit-lock-no-consumer/1.0",
  "feature_flags": {
    "consumer_agent": false,
    "aesthetic_agent": true,
    "final_quality_gate": true
  },
  "final_quality_gate": {
    "schema_version": "FINAL-QUALITY-3.1-ABLATION-NO-CONSUMER",
    "mode": "defect_based_no_score",
    "max_moderate_defects_for_pass": 0,
    "max_minor_defects_for_pass": 2,
    "minimum_review_confidence": 0.6,
    "adversarial_review_on_suspicious_score": true,
    "suspicious_score": {
      "aesthetic_total_at_least": 92,
      "aesthetic_level4_count_at_least": 18
    }
  },
  "retry_policy": {
    "max_redraw_attempts": 8,
    "counter_scope": "global_across_hard_compliance_aesthetic_and_final_quality",
    "count_only_successful_new_candidates": true,
    "return_best_candidate_on_exhaustion": true
  },
  "logging": {
    "structured_round_logs": true,
    "bind_reports_to_request_version_and_image_hash": true,
    "require_ablation_identity": true
  }
}
