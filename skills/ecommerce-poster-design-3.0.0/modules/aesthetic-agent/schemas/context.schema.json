{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchestrator context, not business input",
  "type": "object",
  "properties": {
    "mode": {
      "enum": [
        "standalone",
        "integrated"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "hard_check": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unverified"
          ]
        },
        "report_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "version",
        "status",
        "report_ref"
      ],
      "additionalProperties": false
    },
    "consumer": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unverified"
          ]
        },
        "report_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "version",
        "status",
        "report_ref"
      ],
      "additionalProperties": false
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "width",
        "height",
        "format"
      ],
      "additionalProperties": false
    },
    "protected_content": {
      "type": "object",
      "properties": {
        "product_identity": {"type": "array", "items": {"type": "string"}},
        "product_quantity": {"type": ["integer", "null"], "minimum": 1},
        "brand_and_logo": {"type": "array", "items": {"type": "string"}},
        "price_and_unit": {"type": "array", "items": {"type": "string"}},
        "promotion_and_period": {"type": "array", "items": {"type": "string"}},
        "selling_points": {"type": "array", "items": {"type": "string"}},
        "cta": {"type": "array", "items": {"type": "string"}},
        "legal_text": {"type": "array", "items": {"type": "string"}}
      },
      "required": [
        "product_identity",
        "product_quantity",
        "brand_and_logo",
        "price_and_unit",
        "promotion_and_period",
        "selling_points",
        "cta",
        "legal_text"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "mode",
    "version"
  ],
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "integrated"}},
        "required": ["mode"]
      },
      "then": {
        "required": ["hard_check", "consumer", "protected_content"]
      }
    }
  ],
  "additionalProperties": false
}
