{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-draft.schema.json",
  "title": "Internal visual observation draft",
  "type": "object",
  "properties": {
    "evaluation_blocked": {"type": ["string", "null"]},
    "subcriteria": {
      "type": "object",
      "minProperties": 25,
      "maxProperties": 25,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "level": {"type": "integer", "minimum": 0, "maximum": 4},
          "evidence": {"type": "string", "minLength": 1},
          "enhancement_evidence": {"type": "string"},
          "root_issue_id": {"type": ["string", "null"]}
        },
        "required": ["level", "evidence", "enhancement_evidence", "root_issue_id"],
        "additionalProperties": false
      }
    },
    "critical_issues": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "problem_list": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 3},
    "modify_suggestion": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 3},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "required": ["evaluation_blocked", "critical_issues", "problem_list", "modify_suggestion", "confidence"],
  "additionalProperties": false
}
