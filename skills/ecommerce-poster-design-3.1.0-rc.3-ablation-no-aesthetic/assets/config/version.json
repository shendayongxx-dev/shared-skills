{
  "skill_version": "3.1.0-rc.3-ablation-no-aesthetic",
  "release_channel": "ablation-experiment",
  "production_ready": false,
  "ablation": {
    "id": "no-aesthetic",
    "base_version": "3.1.0-rc.3",
    "base_tag": "ecommerce-poster-design-v3.1.0-rc.3",
    "single_removed_component": "aesthetic_agent_and_all_aesthetic_artifacts",
    "aesthetic_artifacts_allowed": false
  },
  "generation_backend": {
    "skill": "imagegen",
    "tool": "image_gen",
    "mode": "builtin",
    "required": true,
    "cli_fallback_requires_user_confirmation": true,
    "svg_logo_pipeline": {
      "enabled": true,
      "authoritative_source_preserved": true,
      "preflight_schema": "logo-asset-preflight/1.0",
      "application_schema": "logo-application/1.0",
      "default_raster_long_edge": 2048,
      "generation_strategy": "integrated_full_poster_then_deterministic_logo_only"
    }
  },
  "consumer_agent_module": {
    "name": "02-consumer-agent-skill",
    "version": "1.5.3",
    "interface_version": "A-D-2.0",
    "path": "modules/consumer-agent",
    "pass_route_compatibility_value": "aesthetic_agent",
    "pass_route_host_interpretation": "invoke_final_quality_gate"
  },
  "c_library": {
    "status": "connected",
    "asset_mode": "production_internal_reference",
    "official_asset_version": "2.0.1-a.1",
    "source_schema_version": "2.0.0",
    "eligible_seed_cases": 6,
    "seed_scenario_coverage": 6
  },
  "c_candidate_adapter": {
    "status": "implemented",
    "formal_integration": true,
    "supported_source_schemas": ["1.0", "1.0-rc.1", "2.0.0-rc.1", "2.0.0"]
  },
  "workflow_version": "3.1-ablation-no-aesthetic",
  "schema_version": "A-D-2.0",
  "final_quality_edit_contract_version": "final-quality-edit-lock-no-aesthetic/1.0",
  "consumer_lock_enforcement": "pre_generation_contract_and_post_generation_regression_rejection",
  "feature_flags": {
    "consumer_agent": true,
    "aesthetic_agent": false,
    "final_quality_gate": true
  },
  "final_quality_gate": {
    "schema_version": "FINAL-QUALITY-3.1-ABLATION-NO-AESTHETIC",
    "mode": "defect_based_no_score",
    "max_moderate_defects_for_pass": 0,
    "max_minor_defects_for_pass": 2,
    "minimum_review_confidence": 0.6,
    "adversarial_review_on_suspicious_score": true,
    "suspicious_score": {
      "consumer_total_at_least": 96,
      "consumer_all_dimensions_at_least": 19,
      "consumer_level4_count_at_least": 20
    }
  },
  "retry_policy": {
    "max_redraw_attempts": 8,
    "counter_scope": "global_across_hard_compliance_consumer_and_final_quality",
    "count_only_successful_new_candidates": true,
    "return_best_candidate_on_exhaustion": true
  },
  "logging": {
    "structured_round_logs": true,
    "bind_reports_to_request_version_and_image_hash": true,
    "require_ablation_identity": true
  }
}
